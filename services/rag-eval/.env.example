# Copy this file to .env and fill in real values. Never commit the real .env.

# Same Supabase project rag-pipeline/rag-api use (Project Settings -> API in
# the Supabase dashboard). Use the service_role key, not the anon key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# OpenAI API key used for: (1) rag-pipeline's text-embedding-3-small query
# embeddings, (2) rag-api's gpt-5 answer synthesis, and (3) DeepEval's
# LLM-judge scoring (see DEEPEVAL_JUDGE_MODEL below).
OPENAI_API_KEY=sk-your-openai-api-key

# rag-api's `ask_openai()` is called directly as a Python function here (not
# over HTTP), so INTERNAL_API_KEY is never used for request auth - but
# rag_api.config.load_rag_api_settings() still requires it to be set. Any
# non-empty placeholder value works.
INTERNAL_API_KEY=eval-placeholder-not-used-for-auth

# Which model DeepEval uses as the LLM judge for all metrics (contextual
# precision/recall/relevancy, faithfulness, answer relevancy). Defaults to
# gpt-5 (the only chat model already configured in this repo, see
# rag_api/config.py's OPENAI_CHAT_MODEL) if unset.
DEEPEVAL_JUDGE_MODEL=gpt-5

# The Supabase auth.users id whose ingested documents the golden dataset
# queries against. Must already have the sample corpus (or an equivalent
# one matching golden/dataset.yaml) ingested - see golden/README.md.
EVAL_USER_ID=00000000-0000-0000-0000-000000000001
