# Copy this file to .env and fill in real values. Never commit the real .env.

# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# Use the service_role key here, not the anon key: ingestion runs as a
# trusted backend job and needs to bypass row-level security to write.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# OpenAI API key used for text-embedding-3-small.
OPENAI_API_KEY=sk-your-openai-api-key

# Optional. Connection string for a shared Redis instance (e.g.
# redis://user:password@host:6379/0, or rediss://... for TLS), used by
# rag_pipeline/dashboard_cache.py to keep the Overview dashboard's TTL cache
# consistent across every running instance of the service that embeds this
# package (see services/rag-api), instead of each instance holding its own
# independent cache. The same variable is also read by
# services/rag-api/rag_api/rate_limiter.py, via rag_pipeline/
# redis_support.py. Leave unset for local dev / a single-instance
# deployment: both fall back to their original in-process implementation
# with zero external dependencies.
# REDIS_URL=redis://localhost:6379/0
