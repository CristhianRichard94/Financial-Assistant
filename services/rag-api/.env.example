# Copy this file to .env and fill in real values. Never commit the real .env.

# Same Supabase project the rag-pipeline package writes to/reads from
# (Project Settings -> API in the Supabase dashboard). Use the service_role
# key, not the anon key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# OpenAI API key used both for text-embedding-3-small (via rag_pipeline) and
# to synthesize answers from retrieved chunks in POST /query (via the
# gpt-5 chat model - see rag_api/config.py).
OPENAI_API_KEY=sk-your-openai-api-key

# Pre-shared secret this service requires as the `X-Internal-Api-Key` header
# on every route except /healthz (see rag_api/auth.py). This service's ALB is
# public (fronted by CloudFront, not an internal/private ALB), so there is no
# network isolation to rely on - this header is the primary (and only)
# access control for this service. Generate a long random value, e.g.
# `openssl rand -hex 32`, and configure the frontend's RAG_API_INTERNAL_KEY
# with the same value.
INTERNAL_API_KEY=a-long-random-shared-secret

# Optional per-user rate limits (requests per rolling 60s window) enforced
# by rag_api/rate_limiter.py on POST /query, POST /query/agent (shared
# bucket), and POST /upload (separate, lower bucket). Both are optional -
# uncomment to override the defaults from rag_api/config.py.
# QUERY_RATE_LIMIT_PER_MINUTE=20
# UPLOAD_RATE_LIMIT_PER_MINUTE=5

# Optional. Connection string for a shared Redis instance (e.g.
# redis://user:password@host:6379/0, or rediss://... for TLS), used by
# rag_api/rate_limiter.py to enforce the rate limits above across every
# running instance of this service instead of just the one that happens to
# handle a given request. Required once this service is deployed with more
# than one instance/task (see infra/rag_api_stack.py's desired_count) -
# without it, each instance enforces its own independent limit, and the
# effective aggregate limit becomes (configured limit) x (instance count).
# Leave unset for local dev / a single-instance deployment: rag_api/
# rate_limiter.py (and rag_pipeline/dashboard_cache.py, which uses the same
# variable) automatically fall back to their original in-process
# implementation with zero external dependencies.
# REDIS_URL=redis://localhost:6379/0

# Optional for local dev (falls back to SQLite); required before deploying
# via the CDK stack in infra/. Postgres connection string for the agent's
# LangGraph checkpointer (see rag_api/agent/graph.py), used to persist
# multi-turn conversation memory. Leave unset for local development - the
# service falls back to a local SQLite file (AGENT_CHECKPOINT_DB_PATH,
# default agent_checkpoints.sqlite) with zero external dependencies, which is
# fine for local dev/tests but should never be used in a real deployment (see
# graph.py for why). If set, use a Supabase Session pooler connection string
# (Project Settings -> Database -> Connection string -> Session pooler in the
# Supabase dashboard), not the Transaction pooler or direct connection.
# Note: infra/rag_api_stack.py pulls this unconditionally as one of its 5
# required Secrets Manager secrets, so `cdk deploy` will fail unless that
# secret already exists - see DEPLOYMENT.md step 2.
# AGENT_CHECKPOINT_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
